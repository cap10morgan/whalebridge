+@Suite("ContainerCreateRoute.existingContainerConflict")
+struct ExistingContainerConflictTests {
+
+    @Test("a top-level .exists ContainerizationError maps to 409 Conflict")
+    func topLevelExists() throws {
+        let error = ContainerizationError(.exists, message: "container already exists: foo")
+        let conflict = try #require(ContainerCreateRoute.existingContainerConflict(in: error, requestedId: "foo"))
+        #expect(conflict.status == .conflict)
+        #expect(conflict.reason.contains("foo"))
+    }
+
+    @Test("a .exists error wrapped as the cause of ContainerClient.create's internalError still maps to 409")
+    func wrappedInCreateClientError() throws {
+        // Mirrors apple/container's ContainerClient.create, which wraps any XPC
+        // failure in a fresh internalError with the original as `cause`.
+        let inner = ContainerizationError(.exists, message: "container already exists: buildx_buildkit_whalebridge")
+        let outer = ContainerizationError(.internalError, message: "failed to create container", cause: inner)
+        let conflict = try #require(
+            ContainerCreateRoute.existingContainerConflict(in: outer, requestedId: "buildx_buildkit_whalebridge"))
+        #expect(conflict.status == .conflict)
+    }
+
+    @Test("an unrelated error returns nil so the generic 500 path still applies")
+    func unrelatedErrorReturnsNil() {
+        let error = ContainerizationError(.notFound, message: "no such image")
+        #expect(ContainerCreateRoute.existingContainerConflict(in: error, requestedId: "foo") == nil)
+    }
+
+    @Test("a non-ContainerizationError returns nil")
+    func nonContainerizationErrorReturnsNil() {
+        struct SomeOtherError: Error {}
+        #expect(ContainerCreateRoute.existingContainerConflict(in: SomeOtherError(), requestedId: "foo") == nil)
+    }
+}
+
 @Suite("ContainerCreateRoute.validateCpuLimits")
 struct CpuLimitsValidationTests {
 
