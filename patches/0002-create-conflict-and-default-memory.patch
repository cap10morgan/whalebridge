+    /// Apple Container's create serializes concurrent creates under a lock and
+    /// rejects a second create for the same id with a `.exists` error, wrapped
+    /// as the `cause` of the internalError ContainerClient.create throws on any
+    /// XPC failure — so the interesting code can be a couple of layers down,
+    /// not on the top-level error. This is exactly the race buildx's
+    /// docker-container driver is built to survive: when several `docker buildx
+    /// build` processes bootstrap the same builder container concurrently
+    /// (e.g. a multi-image build script), all but one lose the create race.
+    /// Real Docker reports that as an HTTP 409 Conflict, which is what buildx's
+    /// error classification (keyed off status code, not message text) checks
+    /// for to treat the loss as benign and reuse the winner's container instead
+    /// of failing the whole build. Flattening every create failure to a 500,
+    /// as the generic catch-all used to, hid that signal and turned a
+    /// same-machine build race into a hard failure.
+    static func existingContainerConflict(in error: Error, requestedId: String) -> Abort? {
+        var current: Error? = error
+        while let containerizationError = current as? ContainerizationError {
+            if containerizationError.code == .exists {
+                return Abort(
+                    .conflict,
+                    reason:
+                        "Conflict. The container name \"\(requestedId)\" is already in use."
+                        + " You have to remove (or rename) that container to be able to reuse that name."
+                )
+            }
+            current = containerizationError.cause
+        }
+        return nil
+    }
+
